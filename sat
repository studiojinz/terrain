<script>
const orbitData={leo:{tag:"FAST · CLOSE · DETAILED",title:"Low Earth orbit",text:"Most imaging satellites circle a few hundred kilometers above Earth. Being close gives them finer spatial detail, but each pass sees only part of the planet.",altitude:"~400–900 km",use:"Detailed mapping"},sun:{tag:"CONSISTENT LIGHT · REPEATABLE",title:"Sun-synchronous orbit",text:"A near-polar orbit timed so the satellite crosses each location at roughly the same local solar time. Similar illumination makes change through time easier to compare.",altitude:"~600–900 km",use:"Landsat + Sentinel"},geo:{tag:"CONSTANT VIEW · RAPID UPDATES",title:"Geostationary orbit",text:"The satellite circles at the same rate Earth rotates, appearing fixed above one longitude. It continuously watches a hemisphere but at coarser surface detail.",altitude:"35,786 km",use:"Weather + storms"}};
function bindChoices(containerId,callback){document.querySelectorAll(`#${containerId} .choice`).forEach(button=>button.onclick=()=>{document.querySelectorAll(`#${containerId} .choice`).forEach(x=>x.classList.remove("active"));button.classList.add("active");callback(button.dataset)})}
bindChoices("orbitButtons",d=>{const x=orbitData[d.orbit];document.getElementById("orbitVisual").dataset.orbit=d.orbit;document.getElementById("orbitTag").textContent=x.tag;document.getElementById("orbitTitle").textContent=x.title;document.getElementById("orbitText").textContent=x.text;document.getElementById("orbitAltitude").textContent=x.altitude;document.getElementById("orbitUse").textContent=x.use});
const sensorData={optical:{tag:"PASSIVE SENSOR",title:"Optical imagery",text:"Measures sunlight reflected from Earth in visible and infrared wavelengths. It can reveal vegetation, soil, water and built surfaces, but clouds block the view.",question:"Use it to ask: What covers the land, and how is it changing?"},thermal:{tag:"PASSIVE SENSOR",title:"Thermal infrared",text:"Measures emitted energy related to surface temperature. Hot roofs, cool vegetation, water and active fires can separate clearly—even when their visible colors look similar.",question:"Use it to ask: Where is heat stored, released or changing?"},radar:{tag:"ACTIVE SENSOR",title:"Synthetic aperture radar",text:"Sends microwave pulses toward Earth and measures the return. Radar works through cloud and darkness, while moisture, roughness and geometry strongly affect brightness.",question:"Use it to ask: Is the surface wet, rough, moving or deformed?"},lidar:{tag:"ACTIVE SENSOR",title:"LiDAR",text:"Times laser pulses traveling to a surface and back. Billions of distance measurements can reconstruct forest height, ice elevation and detailed three-dimensional terrain.",question:"Use it to ask: How high is the surface, canopy or structure?"}};
const sensorCredits={optical:"LANDSAT 8 · NATURAL COLOR · NASA / USGS",thermal:"MODIS · LAND-SURFACE TEMPERATURE · NASA",radar:"SIR-C/X-SAR · SAFSAF OASIS · NASA / JPL",lidar:"LANDSAT + SRTM ELEVATION · NASA / JPL / USGS"};
bindChoices("sensorButtons",d=>{const x=sensorData[d.sensor];document.getElementById("sensorScene").dataset.sensor=d.sensor;document.getElementById("sensorTag").textContent=x.tag;document.getElementById("sensorTitle").textContent=x.title;document.getElementById("sensorText").textContent=x.text;document.getElementById("sensorQuestion").textContent=x.question;document.getElementById("sensorCredit").textContent=sensorCredits[d.sensor]});
const spectralData={true:{bands:"RED · GREEN · BLUE",title:"True color",text:"Closest to human vision. Familiar and intuitive, but it hides much of the information recorded outside visible wavelengths."},cir:{bands:"NIR · RED · GREEN",title:"Color infrared",text:"Healthy vegetation strongly reflects near-infrared and appears bright red. Water is dark, making plant vigor and boundaries easier to see."},swir:{bands:"SWIR · NIR · RED",title:"Shortwave infrared",text:"Sensitive to moisture and useful for separating burned land, dry soil, vegetation, snow and cloud."},ndvi:{bands:"(NIR − RED) / (NIR + RED)",title:"NDVI",text:"A normalized index that emphasizes photosynthetically active vegetation. High positive values usually indicate dense healthy growth."},thermal:{bands:"THERMAL INFRARED",title:"Surface temperature",text:"Displays emitted heat rather than reflected color. Interpretation depends on acquisition time, material and atmospheric correction."}};
const spectralCredits={true:"LANDSAT 8 · NATURAL COLOR · NASA / USGS",cir:"TERRA MODIS · FALSE COLOR · NASA",swir:"LANDSAT 8 · SWIR / NIR / RED · NASA / USGS",ndvi:"VEGETATION-INDEX DISPLAY · MULTISPECTRAL SOURCE · NASA",thermal:"MODIS · LAND-SURFACE TEMPERATURE · NASA"};
bindChoices("spectralButtons",d=>{const x=spectralData[d.view];document.getElementById("spectralScene").dataset.view=d.view;document.getElementById("spectralBands").textContent=x.bands;document.getElementById("spectralTitle").textContent=x.title;document.getElementById("spectralText").textContent=x.text;document.getElementById("spectralCredit").textContent=spectralCredits[d.view]});
const values={spatial:["1 m","10 m","30 m","500 m"],temporal:["10 min","5 days","16 days","Monthly"],spectral:["3 bands","13 bands","Hundreds","Thousands"]};
function wireRange(id,key){const el=document.getElementById(id),out=document.getElementById(key+"Value");el.oninput=()=>{out.textContent=values[key][+el.value];if(key==="spatial")document.getElementById("pixelDemo").classList.toggle("coarse",+el.value>1)}}wireRange("spatialRange","spatial");wireRange("temporalRange","temporal");wireRange("spectralRange","spectral");
document.getElementById("pixelDemo").innerHTML="<i></i>".repeat(40);
const pipeDetails=["Raw telemetry contains detector readings, timing and spacecraft information. It is not yet a map and usually cannot be interpreted directly.","Calibration converts detector values into consistent radiance or reflectance. Geometric processing assigns pixels to coordinates and corrects sensor or terrain distortion.","Atmospheric correction estimates conditions at the surface. Level-2 products can include surface reflectance, surface temperature and quality masks.","Analysts combine or compare bands to produce measurements such as vegetation indices, burn severity, water extent and change detection.","GIS combines the raster result with boundaries, roads, population, elevation or field observations so it can answer a geographic question."];
document.querySelectorAll(".pipe").forEach(p=>p.onclick=()=>{document.querySelectorAll(".pipe").forEach(x=>x.classList.remove("active"));p.classList.add("active");document.getElementById("pipelineDetail").textContent=pipeDetails[+p.dataset.step]});
</script>
